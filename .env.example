# DATABASE_URL: PostgreSQL / Supabase connection string.
# Example for Supabase: postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=""

# ADMIN_PASSWORD: Initial password for management portal setup
ADMIN_PASSWORD="Celebre@2026"

# JWT_SECRET: Secret key for signing admin and factory session tokens
JWT_SECRET="celebre-catering-jwt-super-secret-key-2026"

# APP_URL: The URL where this applet is hosted (or preview URL / custom domain https://celebre-eg.com)
APP_URL="https://celebre-eg.com"

# -----------------------------------------------------------------------------
# META (MESSENGER & WHATSAPP CLOUD API) INTEGRATION (OPTIONAL)
# If not provided, the application safely operates in STANDALONE_FALLBACK mode
# generating direct wa.me and m.me links with zero risk of booking loss.
# -----------------------------------------------------------------------------
# META_VERIFY_TOKEN: Secret token configured in Meta App Dashboard for webhook verification
META_VERIFY_TOKEN="celebre_meta_verify_token_2026"

# META_PAGE_ACCESS_TOKEN: Meta Graph API Page Access Token for automated Messenger/WhatsApp dispatch
META_PAGE_ACCESS_TOKEN=""

# META_APP_SECRET: Meta App Secret for payload signature verification
