{
  "version": 2,
  "buildCommand": "(node scripts/init-db.mjs || true) && prisma generate && npm run build:api && vite build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/index.js": {
      "includeFiles": "{node_modules/.prisma/client/**,data/**,certs/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api?__path=$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
