{
  "version": 2,
  "buildCommand": "prisma generate && npm run build:api && vite build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/index.js": {
      "includeFiles": "node_modules/.prisma/client/**"
    },
    "api/**/*.ts": {
      "includeFiles": "node_modules/.prisma/client/**"
    },
    "api/index.ts": {
      "includeFiles": "node_modules/.prisma/client/**"
    }
  },
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api?__path=$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
